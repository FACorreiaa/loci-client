{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Profile: bug finding. Every rule in the correctness, suspicious and perf
  // categories, plus the type-aware and pedantic rules below that catch real
  // defects. pedantic/style/restriction stay off as whole categories: they are
  // mostly taste. Run with --type-aware (needs oxlint-tsgolint).
  // There is no Solid plugin for oxlint: the solid/* rules run in ESLint
  // (eslint.config.js, `pnpm run lint:solid`).
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": { "browser": true, "node": true, "worker": true, "es2024": true },
  "ignorePatterns": ["worker-configuration.d.ts"],
  "overrides": [
    // `export {}` is what makes an ambient declaration file a module.
    { "files": ["**/*.d.ts"], "rules": { "unicorn/require-module-specifiers": "off" } },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        // expect(api.method).toHaveBeenCalled() names a mock and never calls
        // it, so there is no `this` to lose. Still an error outside tests.
        "typescript/unbound-method": "off",
        // A bare vi.fn() is a spy whose signature the test does not care
        // about, and the rule also wants parameters on vi.fn(impl), which
        // already infers them.
        "vitest/require-mock-type-parameters": "off",
        // Fixtures and stubs are partial objects asserted to the full type on
        // purpose; a wrong one fails the test that uses it.
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    // The vendored Kobalte wrappers narrow their polymorphic props with
    // `props as XProps<"div">`, the pattern the library documents.
    { "files": ["src/ui/**"], "rules": { "typescript/no-unsafe-type-assertion": "off" } }
  ],
  "rules": {
    // Type-aware bug rules that oxlint files under pedantic.
    "typescript/return-await": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    // Non-type-aware pedantic rules that catch defects rather than style.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "array-callback-return": "error",
    "no-self-compare": "error",
    "no-constructor-return": "error",
    // vitest's expect(value, message) is valid.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],

    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-unassigned-vars": "off",
    // Stylesheets and the fake-indexeddb polyfill are imported for their effect.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "fake-indexeddb/auto"] }],
    // __dirname is Node's name; the other two are deliberate test-only handles.
    "no-underscore-dangle": [
      "error",
      { "allow": ["__dirname", "__lociPush", "__resetAnalyticsForTest"] }
    ],
    // A then() whose result nobody reads has nothing to return.
    "promise/always-return": ["error", { "ignoreLastCallback": true }],

    // Category rules switched off for this codebase, each with its reason.
    // toSorted()/toReversed() are ES2023 and the app ships no polyfills.
    // Every .sort()/.reverse() here already runs on a fresh copy.
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // Every await in a loop here is sequential on purpose (retry with
    // backoff, polling, reading a stream, one upload at a time).
    "no-await-in-loop": "off",
    // Its fix is to mutate the mapped item in place. The copies are the
    // point: the source objects are query data and store state.
    "oxc/no-map-spread": "off",

    // BACKLOG. The one rule of this profile that the existing code still
    // breaks (hit count as of 2026-11-17, with --type-aware; down from 1271
    // across 33 rules). It reports as a warning so CI stays green while every
    // other rule is enforced. What is left is `as any` and `as T` on data
    // that crosses a boundary untyped (JSON, storage, legacy REST shapes):
    // each needs a parser or a type guard, not a rewrite of the cast. To
    // retire it: fix the hits, then delete the line. Never add a rule here.
    "typescript/no-unsafe-type-assertion": "warn" // 193
  }
}
