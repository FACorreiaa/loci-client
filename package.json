{
  "name": "facorreiaa-wanderwise-ai-client",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "tsgo --noEmit && vinxi build",
    "start": "vinxi start",
    "version": "vinxi version",
    "preview": "pnpm run build && npx wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "oxlint .",
    "lint:legacy": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsgo --noEmit",
    "lighthouse": "pnpm run build && lhci autorun --config=./lighthouserc.cjs",
    "lighthouse:collect": "lhci collect --config=./lighthouserc.cjs",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "buf-update": "node scripts/buf-update.mjs",
    "proto-bridge": "node scripts/sync-compare-proto.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@buf/loci_loci-proto.bufbuild_es": "2.14.0-20260828113206-531b9daf9de2.1",
