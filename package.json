    "typecheck": "tsgo --noEmit",
    "lighthouse": "pnpm run build && lhci autorun --config=./lighthouserc.cjs",
    "lighthouse:collect": "lhci collect --config=./lighthouserc.cjs",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
